{
  "name": "klz-monitor",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {},
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts"
      }
    ]
  },
  "migrations": [
    {
      "tag": "accounts-v1",
      "new_sqlite_classes": [
        "Accounts"
      ]
    }
  ]
}
