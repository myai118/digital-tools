{
  "name": "klz-monitor",
  "main": "account-worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts"
      }
    ]
  },
  "exports": {
    "Accounts": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
